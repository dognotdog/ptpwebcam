<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSUIElement</key>
	<true/>
	<key>SMLoginItemRegistrationEnabled</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Used to preview the live camera stream from a connected PTP camera.</string>
	<!-- No Apple-Events usage description: we don't send `aevt/quit`
	     to ImageCapture-holder apps from any process. The "Camera busy"
	     UI is purely informative — the user quits holders themselves
	     and our NSWorkspace termination observer auto-recovers. -->
</dict>
</plist>
