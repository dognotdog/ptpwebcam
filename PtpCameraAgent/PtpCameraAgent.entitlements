<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandboxed. Required for App Store distribution: Apple's review
	     rejects any helper bundled inside a sandboxed parent app unless
	     the helper is itself sandboxed.

	     This used to be `false` because the agent needed to send SIGKILL
	     to ptpcamerad (which App Sandbox blocks across UIDs). That side
	     channel is gone — the extension's USB-open path now uses
	     IOUSBHost's `IOUSBHostObjectInitOptionsDeviceSeize`, which sends
	     a modern eviction message that ptpcamerad's current driver does
	     respond to. The userspace kill is unnecessary, and the agent can
	     run inside the sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Shared app-group with the host app and extension. SMAppService
	     uses this to verify the registration is allowed (sandboxed parent
	     can only register helpers that share an app-group), and Mach
	     service lookups across the three processes resolve through this
	     same group ID. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)org.ptpwebcam.CameraExtension</string>
	</array>
</dict>
</plist>
