<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No app-sandbox: PtpCameraAgent is a LaunchAgent helper, not an App Store app.
	     Without sandbox it can kill ptpcamerad (same UID 501) via kill() and open USB
	     interfaces directly.  The CMIO extension provides the relevant security boundary. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
