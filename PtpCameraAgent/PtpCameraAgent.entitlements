<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandboxed. This pairs with PTPWEBCAM_USB_OPEN_MODE = PLAIN (or
	     SEIZE) in UsbPtpBridge.m. In PLAIN mode the extension does not
	     ask the agent to kill ptpcamerad — instead, when the USB open
	     fails with kIOReturnExclusiveAccess, the agent surfaces a
	     "Camera busy — held by X" menu item that calls
	     NSRunningApplication.terminate() on the offending app. That API
	     is sandbox-allowed for same-user GUI apps.

	     If you switch the bridge to PTPWEBCAM_USB_OPEN_MODE = KILL,
	     this entitlement must flip to `false` — the cross-UID
	     `kill(ptpcamerad)` path the agent uses in KILL mode is blocked
	     by App Sandbox (EPERM). KILL mode is the legacy production path
	     that pre-dates the busy-diagnostic UI; new App Store builds
	     should use PLAIN. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Shared app-group with the host app and extension. Mach service
	     lookups resolve through this group ID, and SMAppService's
	     registration of a sandboxed helper under a sandboxed parent
	     requires it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)org.ptpwebcam.PtpWebcamApp.CameraExtension</string>
	</array>

	<!-- This agent intentionally has NO `automation.apple-events`
	     entitlement. The "Camera busy" UI is purely informative — we
	     list the apps holding the camera and let the user quit them
	     themselves. The `handleAppTerminated(_:)` observer
	     (NSWorkspace.didTerminateApplicationNotification — needs no
	     entitlement) catches each quit and retries the blocked camera
	     claim automatically. -->
</dict>
</plist>
